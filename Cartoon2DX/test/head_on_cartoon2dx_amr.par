# head_on_cartoon2dx_amr.par -- same Brill-Lindquist head-on cartoon
# setup as head_on_cartoon2dx.par, plus BoxInBox AMR that refines in x
# and z only. y stays one cell thick at every level (cartoon
# axisymmetry). See notes.md.

$xmin       = 0.0
$xmax       = +8.0
$ncells_x   = 64
$ncells_z   = 128
$nlevels    = 4
$final_time = 1.0
$out_every  = 16
$regrid_every = 16

ActiveThorns = "
  ADMBaseX
  BoxInBox
  BrillLindquistMulti
  CarpetX
  Cartoon2DX
  CoordinatesX
  CottonmouthZ4c4m
  IOUtil
  ODESolvers
  TmunuBaseX
"

Cactus::cctk_show_schedule       = yes
Cactus::presync_mode             = "mixed-error"
CarpetX::verbose                 = yes
CarpetX::poison_undefined_values = no

Cactus::terminate       = "time"
Cactus::cctk_final_time = $final_time

CarpetX::xmin = $xmin
CarpetX::ymin = -0.0625
CarpetX::zmin = -8.0

CarpetX::xmax = $xmax
CarpetX::ymax = +0.0625
CarpetX::zmax = +8.0

CarpetX::ncells_x = $ncells_x
CarpetX::ncells_y = 1
CarpetX::ncells_z = $ncells_z

CarpetX::ghost_size          = 3
CarpetX::interpolation_order = 3

CarpetX::blocking_factor_x = 8
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 8

# Refine x and z by 2 each level; y stays 1 cell (the thin cartoon slab).
CarpetX::refinement_factor_x = 2
CarpetX::refinement_factor_y = 1
CarpetX::refinement_factor_z = 2

CarpetX::prolongation_type  = "ddf"
CarpetX::prolongation_order = 5

CarpetX::max_num_levels         = $nlevels
CarpetX::regrid_every           = $regrid_every
CarpetX::regrid_error_threshold = 0.9

# Nested cubes centred on the two punctures (z=+-1.15). radius_y is
# unused because the slab is already thinner than any of these radii,
# so every y-cell is tagged and the fine patches span the whole slab.
BoxInBox::num_regions  = 2
BoxInBox::shape_1      = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 1.15
BoxInBox::radius_1     = [-1., 3., 1.5, 0.75]

BoxInBox::shape_2      = "cube"
BoxInBox::num_levels_2 = $nlevels
BoxInBox::position_x_2 = 0.0
BoxInBox::position_y_2 = 0.0
BoxInBox::position_z_2 = -1.15
BoxInBox::radius_2     = [-1., 3., 1.5, 0.75]

CarpetX::boundary_x       = "cartoon"
CarpetX::boundary_y       = "cartoon"
CarpetX::boundary_z       = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "cartoon"
CarpetX::boundary_upper_z = "linear extrapolation"

ADMBaseX::initial_data  = "Brill-Lindquist multi-puncture"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"

CarpetX::dtfac    = 0.25
ODESolvers::method = "RK4"

CottonmouthZ4c4m::eta_beta      = 1.0
CottonmouthZ4c4m::apply_NewRadX = yes
NewRadX::require_tagged_interior_for_radpower = no
NewRadX::apply_y = no
NewRadX::apply_lower_x = no

Cartoon2DX::order   = 4
Cartoon2DX::verbose = yes

IO::out_dir   = $parfile
IO::out_every = $out_every

CarpetX::out_performance = no
CarpetX::out_metadata    = no
CarpetX::out_norm_omit_unstable = no
CarpetX::out_norm_vars = "
  ADMBaseX::metric
  ADMBaseX::curv
  CottonmouthZ4c4m::evo_lapse
  CottonmouthZ4c4m::evo_shift
  CottonmouthZ4c4m::Theta
  CottonmouthZ4c4m::HamCons
  CottonmouthZ4c4m::MomCons
  CottonmouthZ4c4m::ZtCons
"

CarpetX::out_silo_every = $out_every
CarpetX::out_silo_vars = "
  ADMBaseX::metric
  ADMBaseX::curv
  CottonmouthZ4c4m::evo_lapse
  CottonmouthZ4c4m::evo_shift
  CottonmouthZ4c4m::HamCons
  CottonmouthZ4c4m::MomCons
"
